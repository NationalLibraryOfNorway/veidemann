dns_nameservers ${DNS_IP}
negative_dns_ttl 1 second
positive_dns_ttl 7 days

# ----------------------------------------------------------------------
# Chromium -> Squid
# Controlled client, TLS 1.3 only.
# ----------------------------------------------------------------------
# SSL-Bump (see https://wiki.squid-cache.org/ConfigExamples/Intercept/SslBumpExplicit)

http_port 3128 ssl-bump \
 tls-cert=/ca-certificates/tls.crt \
 tls-key=/ca-certificates/tls.key \
 generate-host-certificates=on \
 dynamic_cert_mem_cache_size=32MB \
 options=NO_SSLv3,NO_TLSv1,NO_TLSv1_1,NO_TLSv1_2


sslcrtd_program /usr/lib/squid/security_file_certgen -s /var/spool/squid/ssl_db -M 64MB

acl step1 at_step SslBump1
ssl_bump peek step1
ssl_bump bump all

# ----------------------------------------------------------------------
# Squid -> origins
# Broad compatibility without globally weakening OpenSSL security.
# ----------------------------------------------------------------------
tls_outgoing_options min-version=1.2

# A crawler may intentionally accept broken origin certificates
# This disables certificate-error enforcement but still uses TLS.
sslproxy_cert_error allow all

# Cache ordinary web resources, but do not let large media and downloads
# displace smaller objects that are more likely to be reused during a crawl.
maximum_object_size 16 MB

# Parent peers use no-digest; do not build an unused local cache digest.
digest_generation off

# ----------------------------------------------------------------------
# Store-ID helper
# ----------------------------------------------------------------------

store_id_program /usr/local/sbin/storeid
store_id_extras "%{veidemann_jeid}>h"

store_id_children 5 \
    startup=2 \
    idle=1 \
    concurrency=0

# ----------------------------------------------------------------------
# Internal crawler headers
# ----------------------------------------------------------------------

request_header_access veidemann_eid deny all
request_header_access veidemann_jeid deny all

# Ensure that X-Cache header always contains 'from veidemann_cache' after HIT/MISS
visible_hostname veidemann_cache

# ----------------------------------------------------------------------
# Disk cache
# ----------------------------------------------------------------------

# entrypoint.sh generates cache_dir in /etc/squid/conf.d/95-cache-dir.conf when
# CACHE_DIR_SIZE_PERCENT or CACHE_DIR_SIZE_MB is configured.
