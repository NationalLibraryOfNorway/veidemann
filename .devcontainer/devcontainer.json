{
  "name": "Veidemann",

  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/go:1": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "ms",
      "installGradle": true
    },
    "ghcr.io/devcontainers/features/node:2.1.0": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/nix:1": {
      "multiUser": true,
      "extraNixConfig": "experimental-features = nix-command flakes"
    }
  },

  "mounts": [
    "type=tmpfs,target=/var/lib/docker,tmpfs-mode=0755",
    "source=veidemann-codex,target=/home/vscode/.codex,type=volume"
  ],

  "containerEnv": {
    "GOCACHE": "/tmp/go-build-cache",
    "GRADLE_USER_HOME": "/tmp/gradle-home"
  },

  "postCreateCommand": {
    "agent-tools": "sudo /nix/var/nix/profiles/default/bin/nix profile add --profile /nix/var/nix/profiles/default 'github:maeb/agentics?dir=nix/agent-tools#default'",
    "go-cache": "install -d -m 0700 /tmp/go-build-cache",
    "gradle-cache": "install -d -m 0700 /tmp/gradle-home"
  }
}
