{
  "name": "veidemann-dashboard",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "proxychains": "proxychains ng serve --configuration development",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "test:chromium": "CHROME_BIN=chromium-browser ng test",
    "build:docker": "docker build --build-arg BASE_HREF=${BASE_HREF:-/} --build-arg VERSION=$(git describe --tags --always) -t ${IMAGE:-veidemann-dashboard} .",
    "extract-i18n": "ng extract-i18n",
    "proto:generate": "buf generate --template buf.gen.ts.yaml .."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/localize": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/material-date-fns-adapter": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@bufbuild/protobuf": "^2.16.0",
    "@casl/ability": "^7.0.1",
    "@casl/angular": "^10.0.3",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "angular-oauth2-oidc": "~22.0.2",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "emoji-regex": "^11.0.0",
    "emojibase-data": "^17.0.0",
    "filesize": "^11.0.25",
    "ip-address": "^10.7.3",
    "monaco-editor": "^0.57.0",
    "ngx-echarts": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/schematics": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/language-service": "^22.2.1",
    "@bufbuild/buf": "1.73.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "ng-extract-i18n-merge": "^3.4.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@bufbuild/buf@1.72.0": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
