{
  "name": "veidemann-dashboard",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "proxychains": "proxychains ng serve --configuration development",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "test:chromium": "CHROME_BIN=chromium-browser ng test",
    "build:docker": "docker build --build-arg BASE_HREF=${BASE_HREF:-/} --build-arg VERSION=$(git describe --tags --always) -t ${IMAGE:-veidemann-dashboard} .",
    "extract-i18n": "ng extract-i18n",
    "proto:generate": "buf generate --template buf.gen.ts.yaml .."
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/localize": "^22.1.1",
    "@angular/material": "^22.1.1",
    "@angular/material-date-fns-adapter": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@bufbuild/protobuf": "2.13.0",
    "@casl/ability": "^7.0.1",
    "@casl/angular": "^10.0.3",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2",
    "@fullcalendar/angular": "^7.0.2",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@types/prismjs": "^1.26.6",
    "angular-oauth2-oidc": "~22.0.2",
    "chroma-js": "^3.2.0",
    "cron-schedule": "^6.0.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "emoji-regex": "^10.6.0",
    "emojibase-data": "^17.0.0",
    "filesize": "^11.0.22",
    "ip-address": "^10.5.0",
    "minimist": "~1.2.8",
    "monaco-editor": "^0.55.1",
    "ng-mocks": "^14.16.1",
    "ngx-echarts": "^22.0.0",
    "ngx-monaco-editor-v2": "^22.0.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/language-service": "^22.1.1",
    "@bufbuild/buf": "1.72.0",
    "@eslint/js": "^10.0.1",
    "@juggle/resize-observer": "^3.4.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "ng-extract-i18n-merge": "^3.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
